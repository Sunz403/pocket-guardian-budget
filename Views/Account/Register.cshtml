@model AIShoppingAssistant.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="mx-auto max-w-xl py-6 sm:py-12"><section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/50 sm:p-8"><div class="mb-7"><span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-700">Personalised shopping</span><h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">Create your account</h1><p class="mt-2 text-sm text-slate-500">Save your preferences, budget, and favourite finds.</p></div><form asp-controller="Account" asp-action="Register" method="post" class="space-y-5" novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><div><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Your name" /><span asp-validation-for="FullName" class="mt-1 block text-sm text-red-600"></span></div><div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span></div><div class="grid gap-5 sm:grid-cols-2"><div><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" /><span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span></div><div><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat password" /><span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-red-600"></span></div></div><button class="btn btn-primary w-full" type="submit">Create account <span aria-hidden="true">→</span></button></form><p class="mt-6 text-center text-sm text-slate-500">Already registered? <a class="font-semibold text-brand-700 hover:text-brand-900" asp-controller="Account" asp-action="Login">Log in</a></p></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
