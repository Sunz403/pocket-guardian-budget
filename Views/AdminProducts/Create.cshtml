@model AIShoppingAssistant.Models.Product
@{ ViewData["Title"] = "Add Product"; }
<div class="mx-auto max-w-3xl">
    <a asp-action="Index" class="text-sm font-semibold text-brand-700 hover:text-brand-900">← Back to products</a>
    <section class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h1 class="text-2xl font-bold text-slate-900">Add product</h1>
        <p class="mt-2 text-sm text-slate-500">The added date is recorded automatically.</p>
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="mt-7 space-y-6">
            @Html.AntiForgeryToken()
            <partial name="_ProductForm" model="Model" />
            <div class="flex justify-end gap-3"><a asp-action="Index" class="btn btn-secondary">Cancel</a><button class="btn btn-primary" type="submit">Save product</button></div>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
