@model AIShoppingAssistant.Models.Product
@inject AIShoppingAssistant.Services.FileUploadService FileUploadService
@{ ViewData["Title"] = "Delete Product"; }
<div class="mx-auto max-w-xl"><a asp-action="Index" class="text-sm font-semibold text-brand-700 hover:text-brand-900">← Back to products</a><section class="mt-4 rounded-2xl border border-red-200 bg-white p-6 shadow-sm sm:p-8"><span class="inline-flex rounded-full bg-red-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-red-700">Permanent action</span><div class="mt-4 flex gap-4"><img src="@FileUploadService.GetImageUrl(Model.ImageFileName)" alt="@Model.Name" class="h-24 w-24 rounded border object-cover" /><div><h1 class="text-2xl font-bold text-slate-900">Delete @Model.Name?</h1><p class="mt-2 text-slate-500">This permanently removes the product and its uploaded image.</p></div></div><dl class="mt-6 rounded-xl bg-slate-50 p-4 text-sm"><div class="flex justify-between gap-4"><dt class="text-slate-500">Store</dt><dd class="font-semibold">@Model.StoreName</dd></div><div class="mt-3 flex justify-between gap-4"><dt class="text-slate-500">Price</dt><dd class="font-semibold">@Model.Price.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</dd></div></dl><form asp-action="Delete" method="post" class="mt-7 flex justify-end gap-3">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id" /><a asp-action="Index" class="btn btn-secondary">Cancel</a><button class="btn btn-outline-danger" type="submit">Delete product</button></form></section></div>
