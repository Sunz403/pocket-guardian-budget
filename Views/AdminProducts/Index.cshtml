@model IEnumerable<AIShoppingAssistant.Models.Product>
@inject AIShoppingAssistant.Services.FileUploadService FileUploadService
@{ ViewData["Title"] = "Manage Products"; }
<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-700">Catalogue administration</span><h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Products</h1><p class="mt-2 text-slate-500">Add, review, update, or remove products from the shopping catalogue.</p></div><a asp-action="Create" class="btn btn-primary">Add product <span aria-hidden="true">+</span></a></div>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success" role="alert">@successMessage</div> }
<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Store</th><th>Category</th><th class="text-end">Price</th><th>Added</th><th class="text-end">Actions</th></tr></thead><tbody>@if (Model.Any()) { @foreach (var product in Model) { <tr><td><div class="flex items-center gap-3"><img src="@FileUploadService.GetImageUrl(product.ImageFileName)" alt="@product.Name" class="h-12 w-12 rounded border object-cover" /><div><div class="font-semibold text-slate-900">@product.Name</div><div class="mt-1 max-w-xs truncate text-xs text-slate-500">@product.Description</div></div></div></td><td>@product.StoreName</td><td><span class="badge text-bg-secondary">@product.Category</span></td><td class="text-end font-semibold">@product.Price.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</td><td>@product.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><div class="flex justify-end gap-2"><a asp-action="Details" asp-route-id="@product.Id" class="btn btn-secondary btn-sm">View</a><a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-secondary btn-sm">Edit</a><a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm">Delete</a></div></td></tr> } } else { <tr><td colspan="6" class="py-12 text-center text-slate-500">No products yet. Add the first product to start your catalogue.</td></tr> }</tbody></table></div></div>
