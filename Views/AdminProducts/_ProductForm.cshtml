@model AIShoppingAssistant.Models.Product
@inject AIShoppingAssistant.Services.FileUploadService FileUploadService
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="grid gap-5 md:grid-cols-2">
    <div class="md:col-span-2"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" autocomplete="off" /><span asp-validation-for="Name" class="mt-1 block text-sm text-red-600"></span></div>
    <div class="md:col-span-2"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">R</span><input asp-for="Price" class="form-control" min="0" step="0.01" /></div><span asp-validation-for="Price" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="ShippingCost" class="form-label">Shipping cost</label><div class="input-group"><span class="input-group-text">R</span><input asp-for="ShippingCost" class="form-control" min="0" step="0.01" /></div><span asp-validation-for="ShippingCost" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="StoreName" class="form-label">Store name</label><input asp-for="StoreName" class="form-control" /><span asp-validation-for="StoreName" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="StoreUrl" class="form-label">Store URL</label><input asp-for="StoreUrl" class="form-control" type="url" placeholder="https://www.retailer.co.za/product/123" /><span asp-validation-for="StoreUrl" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /><span asp-validation-for="Category" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="Color" class="form-label"></label><input asp-for="Color" class="form-control" /><span asp-validation-for="Color" class="mt-1 block text-sm text-red-600"></span></div>
    <div><label asp-for="Size" class="form-label"></label><input asp-for="Size" class="form-control" /><span asp-validation-for="Size" class="mt-1 block text-sm text-red-600"></span></div>
    <div class="md:col-span-2">
        <label for="imageFile" class="form-label">Product image</label>
        @if (!string.IsNullOrWhiteSpace(Model.ImageFileName))
        {
            <div class="mb-3"><img src="@FileUploadService.GetImageUrl(Model.ImageFileName)" alt="Current image for @Model.Name" class="h-32 w-32 rounded border object-cover" /></div>
        }
        <input id="imageFile" name="imageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" />
        <p class="mt-1 text-sm text-slate-500">JPG, JPEG, PNG, GIF, or WEBP. Maximum 5 MB.</p>
        <span class="mt-1 block text-sm text-red-600" data-valmsg-for="ImageFile" data-valmsg-replace="true"></span>
        <img id="imagePreview" alt="Image preview" class="mt-3 hidden h-40 w-40 rounded border object-cover" />
    </div>
</div>
<script>
    (() => {
        const input = document.getElementById('imageFile');
        const preview = document.getElementById('imagePreview');
        input?.addEventListener('change', () => {
            const file = input.files?.[0];
            if (!file) return;
            preview.src = URL.createObjectURL(file);
            preview.classList.remove('hidden');
        });
    })();
</script>
