@{
    ViewData["Title"] = "Budget Dashboard";
    var currentMonth = DateTime.Now.Month;
    var currentYear = DateTime.Now.Year;
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Budget Dashboard</h1>
        <p class="text-muted mb-0">Track monthly spending, remaining budget, and category trends.</p>
    </div>
</div>

<div id="budgetAlert" class="alert d-none" role="alert"></div>

<div class="row g-4 mb-4">
    <section class="col-lg-8">
        <div class="border rounded-3 p-4 bg-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h2 class="h5 mb-1">Budget Summary</h2>
                    <span id="summaryPeriod" class="text-muted small"></span>
                </div>
                <span id="budgetStatusBadge" class="badge text-bg-success">0% used</span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <span class="text-muted small">Monthly budget</span>
                        <strong id="monthlyBudget" class="d-block fs-4">R0.00</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <span class="text-muted small">Current spending</span>
                        <strong id="currentSpending" class="d-block fs-4">R0.00</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <span class="text-muted small">Remaining</span>
                        <strong id="remainingAmount" class="d-block fs-4">R0.00</strong>
                    </div>
                </div>
            </div>

            <div class="progress" role="progressbar" aria-label="Budget used" aria-valuemin="0" aria-valuemax="100">
                <div id="budgetProgressBar" class="progress-bar bg-success" style="width: 0%">0%</div>
            </div>
        </div>
    </section>

    <section class="col-lg-4">
        <form id="setBudgetForm" class="border rounded-3 p-4 bg-white shadow-sm h-100">
            <h2 class="h5 mb-3">Set Budget</h2>
            <div class="mb-3">
                <label class="form-label" for="monthlyAmount">Monthly amount</label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input id="monthlyAmount" class="form-control" type="number" min="0" max="999999.99" step="0.01" required />
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <label class="form-label" for="budgetMonth">Month</label>
                    <select id="budgetMonth" class="form-select"></select>
                </div>
                <div class="col-6">
                    <label class="form-label" for="budgetYear">Year</label>
                    <select id="budgetYear" class="form-select"></select>
                </div>
            </div>
            <button id="setBudgetButton" class="btn btn-primary w-100" type="submit">Set Budget</button>
        </form>
    </section>
</div>

<div class="row g-4">
    <section class="col-xl-7">
        <div class="border rounded-3 p-4 bg-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <h2 class="h5 mb-0">Recent Spending History</h2>
                <span class="text-muted small"><span id="totalItemsPurchased">0</span> items this month</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th class="text-end">Amount</th>
                            <th>Store</th>
                        </tr>
                    </thead>
                    <tbody id="spendingHistoryBody">
                        <tr>
                            <td colspan="4" class="text-muted">Loading spending history...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="col-xl-5">
        <div class="border rounded-3 p-4 bg-white shadow-sm h-100">
            <h2 class="h5 mb-3">Spending by Category</h2>
            <canvas id="categoryChart" height="260"></canvas>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const monthNames = [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'
            ];
            const currentMonth = @currentMonth;
            const currentYear = @currentYear;
            let categoryChart;

            const alertBox = document.getElementById('budgetAlert');
            const monthSelect = document.getElementById('budgetMonth');
            const yearSelect = document.getElementById('budgetYear');
            const form = document.getElementById('setBudgetForm');
            const setButton = document.getElementById('setBudgetButton');

            function initSelectors() {
                monthSelect.innerHTML = monthNames
                    .map((month, index) => `<option value="${index + 1}">${month}</option>`)
                    .join('');

                const years = [];
                for (let year = currentYear - 2; year <= currentYear + 2; year += 1) {
                    years.push(year);
                }

                yearSelect.innerHTML = years
                    .map(year => `<option value="${year}">${year}</option>`)
                    .join('');

                monthSelect.value = String(currentMonth);
                yearSelect.value = String(currentYear);
            }

            async function loadBudgetData() {
                const month = Number(monthSelect.value);
                const year = Number(yearSelect.value);
                const [summaryResponse, historyResponse] = await Promise.all([
                    fetch(`/Budget/GetBudgetSummary?month=${month}&year=${year}`, {
                        headers: {
                            Accept: 'application/json'
                        }
                    }),
                    fetch(`/Budget/GetSpendingHistory?month=${month}&year=${year}`, {
                        headers: {
                            Accept: 'application/json'
                        }
                    })
                ]);

                const summaryData = await readJson(summaryResponse);
                const historyData = await readJson(historyResponse);

                if (!summaryResponse.ok || summaryData?.success === false) {
                    throw new Error(summaryData?.message || 'Could not load your budget summary.');
                }

                if (!historyResponse.ok || historyData?.success === false) {
                    throw new Error(historyData?.message || 'Could not load your spending history.');
                }

                renderDashboard({
                    summary: summaryData,
                    history: historyData.purchases || [],
                    totalItemsPurchased: historyData.totalItemsPurchased || 0,
                    categories: historyData.categories || []
                });
            }

            form.addEventListener('submit', async event => {
                event.preventDefault();
                setButton.disabled = true;
                setButton.textContent = 'Saving...';

                try {
                    const response = await fetch('/Budget/SetBudget', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            Accept: 'application/json'
                        },
                        body: JSON.stringify({
                            monthlyAmount: Number(document.getElementById('monthlyAmount').value),
                            month: Number(monthSelect.value),
                            year: Number(yearSelect.value)
                        })
                    });

                    const data = await readJson(response);
                    if (!response.ok || data?.success === false) {
                        throw new Error(data?.message || 'Could not set budget.');
                    }

                    showMessage(data?.message || 'Budget saved successfully.', 'success');
                    await loadBudgetData();
                } catch (error) {
                    showMessage(error.message, 'danger');
                } finally {
                    setButton.disabled = false;
                    setButton.textContent = 'Set Budget';
                }
            });

            monthSelect.addEventListener('change', refreshSelectedPeriod);
            yearSelect.addEventListener('change', refreshSelectedPeriod);

            async function refreshSelectedPeriod() {
                try {
                    await loadBudgetData();
                } catch (error) {
                    showMessage(error.message, 'warning');
                }
            }

            function renderDashboard(data) {
                const summary = data.summary || {};
                const percentage = Number(summary.percentageUsed || 0);
                const progressWidth = Math.min(100, Math.max(0, percentage));
                const color = percentage > 90 ? 'danger' : percentage >= 70 ? 'warning' : 'success';

                document.getElementById('summaryPeriod').textContent = `${monthNames[(summary.month || currentMonth) - 1]} ${summary.year || currentYear}`;
                document.getElementById('monthlyBudget').textContent = formatCurrency(summary.monthlyAmount);
                document.getElementById('currentSpending').textContent = formatCurrency(summary.currentSpending);
                document.getElementById('remainingAmount').textContent = formatCurrency(summary.remaining);
                document.getElementById('monthlyAmount').value = Number(summary.monthlyAmount || 0).toFixed(2);

                const badge = document.getElementById('budgetStatusBadge');
                badge.className = `badge text-bg-${color}`;
                badge.textContent = `${percentage.toFixed(1)}% used`;

                const progressBar = document.getElementById('budgetProgressBar');
                progressBar.className = `progress-bar bg-${color}`;
                progressBar.style.width = `${progressWidth}%`;
                progressBar.textContent = `${percentage.toFixed(1)}%`;

                renderHistory(data.history || []);
                document.getElementById('totalItemsPurchased').textContent = data.totalItemsPurchased || 0;
                renderCategoryChart(data.categories || []);
            }

            function renderHistory(history) {
                const body = document.getElementById('spendingHistoryBody');
                if (history.length === 0) {
                    body.innerHTML = '<tr><td colspan="4" class="text-muted">No purchases recorded for this month.</td></tr>';
                    return;
                }

                body.innerHTML = history.map(item => `
                    <tr>
                        <td>${formatDate(item.date)}</td>
                        <td>${escapeHtml(item.product || 'Product')}</td>
                        <td class="text-end">${formatCurrency(item.amount)}</td>
                        <td>${escapeHtml(item.store || 'Unknown')}</td>
                    </tr>
                `).join('');
            }

            function renderCategoryChart(categories) {
                const labels = categories.map(item => item.category);
                const amounts = categories.map(item => Number(item.amount || 0));
                const context = document.getElementById('categoryChart');

                if (categoryChart) {
                    categoryChart.destroy();
                }

                categoryChart = new Chart(context, {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Spending',
                            data: amounts,
                            backgroundColor: '#198754'
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: value => formatCurrency(value)
                                }
                            }
                        }
                    }
                });
            }

            function showMessage(message, type) {
                alertBox.textContent = message;
                alertBox.className = `alert alert-${type}`;
            }

            async function readJson(response) {
                const contentType = response.headers.get('content-type') || '';
                const text = await response.text();

                if (!contentType.includes('application/json')) {
                    if (response.redirected || response.url.includes('/Account/Login')) {
                        throw new Error('Please sign in again to view your budget dashboard.');
                    }

                    throw new Error('The server returned an unexpected response. Please try again.');
                }

                return text ? JSON.parse(text) : null;
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(Number(value || 0));
            }

            function formatDate(value) {
                return new Intl.DateTimeFormat('en-ZA', { dateStyle: 'medium' }).format(new Date(value));
            }

            function escapeHtml(value) {
                const div = document.createElement('div');
                div.textContent = value;
                return div.innerHTML;
            }

            initSelectors();
            loadBudgetData().catch(error => showMessage(error.message, 'warning'));
        })();
    </script>
}
