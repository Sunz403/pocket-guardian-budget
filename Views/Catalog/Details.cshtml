@model AIShoppingAssistant.Models.Product
@inject AIShoppingAssistant.Services.FileUploadService FileUploadService
@{ ViewData["Title"] = Model.Name; }
<div class="mx-auto max-w-3xl"><a href="/Catalog" class="text-sm font-semibold text-brand-700 hover:text-brand-900">← Back to catalog</a><section class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="grid md:grid-cols-5"><div class="bg-slate-100 md:col-span-2"><img src="@FileUploadService.GetImageUrl(Model.ImageFileName)" alt="@Model.Name" class="h-full min-h-56 w-full object-cover" /></div><div class="p-6 sm:p-8 md:col-span-3"><span class="badge text-bg-secondary">@Model.Category</span><h1 class="mt-3 text-2xl font-bold text-slate-900">@Model.Name</h1><p class="mt-2 text-slate-500">@Model.Description</p><strong class="mt-4 block text-xl text-brand-700">@Model.Price.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</strong><dl class="mt-7 grid grid-cols-2 gap-5 text-sm"><div><dt class="text-slate-500">Store</dt><dd class="mt-1 font-semibold">@Model.StoreName</dd></div><div><dt class="text-slate-500">Shipping</dt><dd class="mt-1 font-semibold">@Model.ShippingCost.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</dd></div></dl><button class="btn btn-primary mt-8" type="button" data-visit-store="@Model.Id">Buy Now</button></div></div></section></div>
@section Scripts { <script>document.querySelector('[data-visit-store]')?.addEventListener('click', event => window.visitStore(+event.currentTarget.dataset.visitStore));</script> }
