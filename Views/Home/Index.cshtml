@{
    ViewData["Title"] = "Home";
}

<section class="home-hero rounded-3 p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase text-success fw-semibold small mb-2">Smart shopping, grounded in your budget</p>
            <h1 class="display-5 fw-bold mb-3">Welcome to your AI Shopping Assistant</h1>
            <p class="lead mb-4">
                Find products that fit your style, preferences, location, and monthly budget with help from a local AI model.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-success btn-lg" href="/Shopping/Assistant">Start Shopping</a>
                <a class="btn btn-outline-dark btn-lg" href="/Budget/Index">Review Budget</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="status-panel p-4 bg-white rounded-3 shadow-sm">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div>
                        <h2 class="h5 mb-1">AI Model Status</h2>
                        <p class="text-muted mb-0">Local recommendation engine health</p>
                    </div>
                    <span id="aiModelStatus" class="badge text-bg-secondary">Checking...</span>
                </div>
                <div id="aiModelStatusDetails" class="small text-muted mt-3">Contacting health endpoint.</div>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Shopping/Assistant">
            <span class="feature-title">Shopping Assistant</span>
            <span class="feature-copy">Ask for product ideas in plain language.</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Budget/Index">
            <span class="feature-title">My Budget</span>
            <span class="feature-copy">Track spending against this month.</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Preferences/Index">
            <span class="feature-title">My Preferences</span>
            <span class="feature-copy">Keep styles, colors, and stores current.</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Cart/Index">
            <span class="feature-title">My Cart</span>
            <span class="feature-copy">Review items before checkout.</span>
        </a>
    </div>
</section>

<section class="app-summary">
    <h2 class="h4 mb-3">How it helps</h2>
    <p class="mb-0">
        The app combines product data, your saved preferences, monthly budget tracking, and AI recommendations to make shopping decisions clearer before you buy.
    </p>
</section>
