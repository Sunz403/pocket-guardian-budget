@{
    ViewData["Title"] = "Home";
}

<section class="home-hero rounded-3 p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase text-success fw-semibold small mb-2">Practical planning, grounded in your budget</p>
            <h1 class="display-5 fw-bold mb-3">Welcome to your Budgeting Assistant</h1>
            <p class="lead mb-4">
                Select catalog items and understand exactly how each choice affects your monthly budget.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-success btn-lg" href="/Catalog">Browse Catalog</a>
                <a class="btn btn-outline-dark btn-lg" href="/Budget/Index">Review Budget</a>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Catalog">
            <span class="feature-title">Catalog</span>
            <span class="feature-copy">Browse items to include in your budget plan.</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Budget/Index">
            <span class="feature-title">My Budget</span>
            <span class="feature-copy">Track spending against this month.</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/Preferences/Index">
            <span class="feature-title">My Preferences</span>
            <span class="feature-copy">Keep styles, colors, and stores current.</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="feature-link h-100" href="/ShoppingList">
            <span class="feature-title">Shopping List</span>
            <span class="feature-copy">Review selected items and their budget impact.</span>
        </a>
    </div>
</section>

<section class="app-summary">
    <h2 class="h4 mb-3">How it helps</h2>
    <p class="mb-0">
        The app combines product data, your saved preferences, and monthly budget tracking to make spending plans clearer.
    </p>
</section>
