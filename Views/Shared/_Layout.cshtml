<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BudgetBuddy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] }, colors: { brand: { 50: '#ecfdf5', 500: '#10b981', 600: '#059669', 700: '#047857', 900: '#064e3b' } } } }
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/95 text-white shadow-lg shadow-slate-950/10 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Main navigation">
            <a class="group flex items-center gap-2 text-base font-bold tracking-tight" asp-controller="Catalog" asp-action="Index"><span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-500 text-lg shadow-lg shadow-brand-500/30 transition group-hover:scale-105">✦</span> Budgeting Assistant</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
            <button id="menuButton" class="rounded-lg p-2 text-slate-200 transition hover:bg-white/10 lg:hidden" type="button" aria-label="Toggle navigation" aria-expanded="false">☰</button>
            <div id="mainNavigation" class="hidden absolute inset-x-0 top-full border-b border-white/10 bg-slate-950 px-4 pb-4 lg:static lg:flex lg:items-center lg:gap-7 lg:border-0 lg:bg-transparent lg:p-0">
                <div class="flex flex-col gap-1 pt-3 lg:flex-row lg:items-center lg:gap-1 lg:pt-0">
                    <a class="nav-link" href="/Catalog">Catalog</a>
                    <a class="nav-link" href="/ShoppingList">Shopping List</a>
                    <div class="nav-dropdown group relative">
                        <button class="nav-link flex items-center gap-1" type="button">My account <span class="text-xs">⌄</span></button>
                        <div class="dropdown-menu lg:absolute lg:left-0 lg:top-full lg:hidden lg:w-52 lg:pt-2 lg:group-hover:block lg:group-focus-within:block">
                            <div class="rounded-xl border border-slate-200 bg-white p-2 shadow-xl"><a class="dropdown-link" href="/Budget/Index">Budget dashboard</a><a class="dropdown-link" href="/Preferences/Index">Preferences</a>@if (User.Identity?.IsAuthenticated == true) { <a class="dropdown-link" asp-controller="AdminProducts" asp-action="Index">Manage products</a> }</div>
                        </div>
                    </div>
                </div>
                <div class="mt-3 flex items-center gap-2 border-t border-white/10 pt-3 lg:mt-0 lg:ml-auto lg:border-0 lg:pt-0">
                    <span class="hidden text-sm text-slate-300 sm:block">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-secondary text-sm" type="submit">Log out</button></form>
                </div>
            </div>
            }
            else
            {
            <div class="flex items-center gap-2">
                <a class="btn btn-secondary text-sm" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="btn btn-primary text-sm" asp-controller="Account" asp-action="Register">Get started</a>
            </div>
            }
        </nav>
    </header>
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8 lg:py-10">@RenderBody()</main>
    <footer class="mt-auto border-t border-slate-200 bg-white"><div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:justify-between sm:px-6 lg:px-8"><span>&copy; @DateTime.Now.Year BudgetBuddy</span><a class="transition hover:text-teal-700" asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
    <div id="appToast" class="pointer-events-none absolute left-1/2 top-20 z-50 hidden max-w-sm -translate-x-1/2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow-xl" role="status" aria-live="polite"></div>
    <section id="shoppingAssistant" class="shopping-assistant" aria-label="AI Shopping Assistant" data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
        <button id="chatLauncher" class="chat-launcher" type="button" aria-label="Open AI Shopping Assistant" aria-expanded="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.48 8.5 8.5 0 0 1-3.3-.7L4 20l1.45-3.72A7.46 7.46 0 1 1 20 11.5Z"></path><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"></path></svg>
            <span class="chat-launcher-pulse" aria-hidden="true"></span>
        </button>
        <div id="chatPanel" class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chatTitle" aria-hidden="true">
            <header class="chat-panel-header"><div><span class="chat-presence" aria-hidden="true"></span><div><h2 id="chatTitle">AI Shopping Assistant</h2><p>Here to help you spend smarter</p></div></div><button id="chatClose" class="chat-close" type="button" aria-label="Minimize chat">&times;</button></header>
            <div id="chatMessages" class="chat-messages" aria-live="polite"></div>
            <div id="chatTyping" class="chat-typing" hidden><span>AI is thinking</span><i></i><i></i><i></i></div>
            <form id="chatForm" class="chat-composer"><div class="chat-input-row"><input id="chatInput" type="text" maxlength="4000" autocomplete="off" placeholder="Ask about your budget or products" aria-label="Message AI Shopping Assistant"><button id="chatSend" type="submit" disabled>Send</button></div><div class="chat-actions" aria-label="Suggested questions"><button type="button" data-chat-prompt="Give me budget advice for this month.">Budget Advice</button><button type="button" data-chat-prompt="Find products that suit my budget.">Find Products</button><button type="button" data-chat-prompt="What is my budget status?">My Budget Status</button><button type="button" data-chat-prompt="What can you help me with?">Help</button></div></form>
        </div>
    </section>
    <script>
        document.getElementById('menuButton')?.addEventListener('click', function () { const menu = document.getElementById('mainNavigation'); menu.classList.toggle('hidden'); this.setAttribute('aria-expanded', String(!menu.classList.contains('hidden'))); });
        window.showToast = (message) => { const toast = document.getElementById('appToast'); toast.textContent = message; toast.classList.remove('hidden'); clearTimeout(window.appToastTimeout); window.appToastTimeout = setTimeout(() => toast.classList.add('hidden'), 3500); };
        window.visitStore = async (productId) => {
            const storeWindow = window.open('', '_blank');
            try {
                const response = await fetch(`/api/products/${productId}/visit`, { method: 'POST', headers: { Accept: 'application/json' } });
                const data = await response.json();
                if (!response.ok) throw new Error(data.message || 'Could not open the store.');
                if (!data.url) { storeWindow?.close(); window.showToast('Store URL not available for this product.'); return; }
                window.showToast(data.hasProductUrl ? `Redirecting to ${data.storeName}...` : 'Store URL not available for this product.');
                if (storeWindow) storeWindow.location.href = data.url;
                else window.open(data.url, '_blank', 'noopener');
            } catch (error) { storeWindow?.close(); window.showToast(error.message || 'Could not open the store.'); }
        };
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
