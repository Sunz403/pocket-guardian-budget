<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AI Shopping</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] }, colors: { brand: { 50: '#ecfdf5', 500: '#10b981', 600: '#059669', 700: '#047857', 900: '#064e3b' } } } }
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/95 text-white shadow-lg shadow-slate-950/10 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Main navigation">
            <a class="group flex items-center gap-2 text-base font-bold tracking-tight" asp-controller="Home" asp-action="Index"><span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-500 text-lg shadow-lg shadow-brand-500/30 transition group-hover:scale-105">✦</span> AI Shopping</a>
            <button id="menuButton" class="rounded-lg p-2 text-slate-200 transition hover:bg-white/10 lg:hidden" type="button" aria-label="Toggle navigation" aria-expanded="false">☰</button>
            <div id="mainNavigation" class="hidden absolute inset-x-0 top-full border-b border-white/10 bg-slate-950 px-4 pb-4 lg:static lg:flex lg:items-center lg:gap-7 lg:border-0 lg:bg-transparent lg:p-0">
                <div class="flex flex-col gap-1 pt-3 lg:flex-row lg:items-center lg:gap-1 lg:pt-0">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    <div class="nav-dropdown group relative">
                        <button class="nav-link flex items-center gap-1" type="button">Shop <span class="text-xs">⌄</span></button>
                        <div class="dropdown-menu lg:absolute lg:left-0 lg:top-full lg:hidden lg:w-52 lg:pt-2 lg:group-hover:block lg:group-focus-within:block">
                            <div class="rounded-xl border border-slate-200 bg-white p-2 shadow-xl"><a class="dropdown-link" href="/Shopping/Assistant">Shopping Assistant</a><a class="dropdown-link" href="/Cart/Index">My Cart</a></div>
                        </div>
                    </div>
                    <div class="nav-dropdown group relative">
                        <button class="nav-link flex items-center gap-1" type="button">My account <span class="text-xs">⌄</span></button>
                        <div class="dropdown-menu lg:absolute lg:left-0 lg:top-full lg:hidden lg:w-52 lg:pt-2 lg:group-hover:block lg:group-focus-within:block">
                            <div class="rounded-xl border border-slate-200 bg-white p-2 shadow-xl"><a class="dropdown-link" href="/Budget/Index">Budget dashboard</a><a class="dropdown-link" href="/Preferences/Index">Preferences</a></div>
                        </div>
                    </div>
                </div>
                <div class="mt-3 flex items-center gap-2 border-t border-white/10 pt-3 lg:mt-0 lg:ml-auto lg:border-0 lg:pt-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="hidden text-sm text-slate-300 sm:block">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-secondary text-sm" type="submit">Log out</button></form>
                    }
                    else
                    {
                        <a class="btn btn-secondary text-sm" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-primary text-sm" asp-controller="Account" asp-action="Register">Get started</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8 lg:py-12">@RenderBody()</main>
    <footer class="mt-auto border-t border-slate-200 bg-white"><div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:justify-between sm:px-6 lg:px-8"><span>&copy; @DateTime.Now.Year AI Shopping Assistant</span><a class="transition hover:text-brand-700" asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
    <script>document.getElementById('menuButton')?.addEventListener('click', function () { const menu = document.getElementById('mainNavigation'); menu.classList.toggle('hidden'); this.setAttribute('aria-expanded', String(!menu.classList.contains('hidden'))); });</script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
