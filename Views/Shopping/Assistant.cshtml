@{
    ViewData["Title"] = "Shopping Assistant";
}

<section class="shopping-shell">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-2">Shopping Assistant</h1>
            <p class="text-muted mb-0">Describe what you need and let the AI match products to your budget and preferences.</p>
        </div>
        <a class="btn btn-outline-dark" href="/Cart/Index">View Cart</a>
    </div>

    <form id="shoppingSearchForm" class="search-panel bg-white border rounded-3 p-3 p-lg-4 shadow-sm mb-4">
        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label fw-semibold" for="userQuery">What are you shopping for?</label>
                <input id="userQuery" name="userQuery" class="form-control form-control-lg" type="text" placeholder="I need a red running shoe under R500" required maxlength="1000" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label fw-semibold" for="budget">Budget</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">R</span>
                    <input id="budget" name="budget" class="form-control" type="number" min="0" step="0.01" placeholder="Optional" />
                </div>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label fw-semibold" for="location">Postal code</label>
                <input id="location" name="location" class="form-control form-control-lg" type="text" maxlength="30" placeholder="Optional" />
            </div>
            <div class="col-lg-2">
                <label class="form-label fw-semibold" for="maxDistance">Distance: <span id="distanceValue">0</span>km</label>
                <input id="maxDistance" name="maxDistance" class="form-range mt-2" type="range" min="0" max="50" step="1" value="0" />
            </div>
        </div>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mt-4">
            <button id="searchButton" class="btn btn-success btn-lg px-4" type="submit">
                <span id="searchSpinner" class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>
                <span id="searchButtonText">Search</span>
            </button>
            <span id="searchMessage" class="small text-muted"></span>
        </div>
    </form>

    <div id="resultsSection" class="d-none">
        <div id="aiExplanation" class="alert alert-success shadow-sm"></div>
        <div id="budgetSummary" class="row g-3 mb-4"></div>
        <div id="productsGrid" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4"></div>
    </div>

    <div id="emptyState" class="text-center bg-white border rounded-3 p-5 shadow-sm">
        <h2 class="h4 mb-2">Ready when you are</h2>
        <p class="text-muted mb-0">Search results and AI recommendations will appear here.</p>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("shoppingSearchForm");
            const distanceInput = document.getElementById("maxDistance");
            const distanceValue = document.getElementById("distanceValue");
            const button = document.getElementById("searchButton");
            const spinner = document.getElementById("searchSpinner");
            const buttonText = document.getElementById("searchButtonText");
            const message = document.getElementById("searchMessage");
            const resultsSection = document.getElementById("resultsSection");
            const emptyState = document.getElementById("emptyState");
            const aiExplanation = document.getElementById("aiExplanation");
            const budgetSummary = document.getElementById("budgetSummary");
            const productsGrid = document.getElementById("productsGrid");

            distanceInput.addEventListener("input", function () {
                distanceValue.textContent = distanceInput.value;
            });

            form.addEventListener("submit", async function (event) {
                event.preventDefault();
                setLoading(true);
                message.textContent = "";

                const payload = {
                    userQuery: document.getElementById("userQuery").value.trim(),
                    budget: getOptionalNumber("budget"),
                    location: getOptionalText("location"),
                    maxDistance: Number(distanceInput.value) > 0 ? Number(distanceInput.value) : null
                };

                try {
                    const response = await fetch("/api/shopping/assistant", {
                        method: "POST",
                        headers: getJsonHeaders(),
                        body: JSON.stringify(payload)
                    });
                    const data = await readJson(response);

                    if (!response.ok) {
                        throw new Error(data?.message || data?.title || "Search failed.");
                    }

                    renderResults(data);
                } catch (error) {
                    showNoResults(error.message);
                } finally {
                    setLoading(false);
                }
            });

            productsGrid.addEventListener("click", async function (event) {
                const addButton = event.target.closest("[data-add-to-cart]");
                if (!addButton) {
                    return;
                }

                addButton.disabled = true;
                const originalText = addButton.textContent;
                addButton.textContent = "Adding...";

                try {
                    const response = await fetch("/api/shopping/cart/add", {
                        method: "POST",
                        headers: getJsonHeaders(),
                        body: JSON.stringify({ productId: Number(addButton.dataset.productId), quantity: 1 })
                    });
                    const data = await readJson(response);

                    if (!response.ok) {
                        throw new Error(data?.message || data?.title || "Could not add item.");
                    }

                    addButton.textContent = "Added";
                    addButton.classList.remove("btn-success");
                    addButton.classList.add("btn-outline-success");
                } catch (error) {
                    addButton.textContent = originalText;
                    message.textContent = error.message;
                } finally {
                    setTimeout(function () {
                        addButton.disabled = false;
                        if (addButton.textContent === "Added") {
                            addButton.textContent = originalText;
                            addButton.classList.add("btn-success");
                            addButton.classList.remove("btn-outline-success");
                        }
                    }, 1400);
                }
            });

            function renderResults(data) {
                const products = data.recommendedProducts || [];
                resultsSection.classList.remove("d-none");
                emptyState.classList.add("d-none");
                aiExplanation.innerHTML = "<strong>AI recommendation:</strong> " + escapeHtml(data.aiExplanation || "Here are the best matches I found.");
                renderBudget(data.budgetSummary);

                if (products.length === 0) {
                    productsGrid.innerHTML = '<div class="col"><div class="alert alert-light border mb-0">No results found. Try widening your budget, distance, or product description.</div></div>';
                    return;
                }

                productsGrid.innerHTML = products.map(renderProductCard).join("");
            }

            function renderBudget(summary) {
                const current = Number(summary?.currentBudget || 0);
                const remaining = Number(summary?.remaining || 0);
                const used = Number(summary?.percentageUsed || 0);
                const spending = Math.max(0, current - remaining);
                budgetSummary.innerHTML = [
                    budgetTile("Current spending", formatCurrency(spending)),
                    budgetTile("Remaining", formatCurrency(remaining)),
                    budgetTile("Used", used.toFixed(2) + "%")
                ].join("");
            }

            function budgetTile(label, value) {
                return '<div class="col-md-4"><div class="budget-tile bg-white border rounded-3 p-3 shadow-sm"><span class="text-muted small">' +
                    escapeHtml(label) + '</span><strong class="d-block fs-4">' + escapeHtml(value) + '</strong></div></div>';
            }

            function renderProductCard(product) {
                const imageUrl = product.imageUrl || "https://placehold.co/640x420/e9ecef/495057?text=Product";
                return '<div class="col"><article class="product-card card h-100 shadow-sm">' +
                    '<img src="' + escapeAttribute(imageUrl) + '" class="card-img-top product-image" alt="' + escapeAttribute(product.name || "Product image") + '">' +
                    '<div class="card-body d-flex flex-column">' +
                    '<div class="d-flex justify-content-between gap-3 mb-2"><h2 class="h5 card-title mb-0">' + escapeHtml(product.name || "Product") + '</h2><strong class="text-success text-nowrap">' + formatCurrency(product.price) + '</strong></div>' +
                    '<div class="product-meta small text-muted mb-3">' +
                    '<span>Color: ' + escapeHtml(product.color || "N/A") + '</span>' +
                    '<span>Size: ' + escapeHtml(product.size || "N/A") + '</span>' +
                    '<span>Store: ' + escapeHtml(product.storeName || "N/A") + '</span>' +
                    '<span>Shipping: ' + formatCurrency(product.shippingCost || 0) + '</span>' +
                    '</div>' +
                    '<span class="badge text-bg-light border align-self-start mb-3 text-wrap">' + escapeHtml(product.aiReason || "Recommended match") + '</span>' +
                    '<button class="btn btn-success mt-auto" type="button" data-add-to-cart data-product-id="' + Number(product.id) + '">Add to Cart</button>' +
                    '</div></article></div>';
            }

            function setLoading(isLoading) {
                button.disabled = isLoading;
                spinner.classList.toggle("d-none", !isLoading);
                buttonText.textContent = isLoading ? "Searching..." : "Search";
            }

            function showNoResults(text) {
                resultsSection.classList.add("d-none");
                emptyState.classList.remove("d-none");
                emptyState.innerHTML = '<h2 class="h4 mb-2">No results</h2><p class="text-muted mb-0">' + escapeHtml(text) + '</p>';
            }

            function getOptionalNumber(id) {
                const value = document.getElementById(id).value;
                return value ? Number(value) : null;
            }

            function getOptionalText(id) {
                const value = document.getElementById(id).value.trim();
                return value || null;
            }

            function getJsonHeaders() {
                return { "Content-Type": "application/json", "Accept": "application/json" };
            }

            async function readJson(response) {
                const text = await response.text();
                return text ? JSON.parse(text) : null;
            }

            function formatCurrency(value) {
                return new Intl.NumberFormat("en-ZA", { style: "currency", currency: "ZAR" }).format(Number(value || 0));
            }

            function escapeHtml(value) {
                const div = document.createElement("div");
                div.textContent = value;
                return div.innerHTML;
            }

            function escapeAttribute(value) {
                return escapeHtml(value).replace(/"/g, "&quot;");
            }
        })();
    </script>
}
