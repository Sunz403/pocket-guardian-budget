@{ ViewData["Title"] = "Shopping List"; }
<section>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><h1 class="h2 fw-bold mb-1">Shopping List</h1><p class="text-muted mb-0">Your selected items are planning choices only—there is no checkout.</p></div><a href="/Catalog" class="btn btn-outline-primary">Browse Catalog</a></div>
    <div id="listAlert" class="alert d-none" role="alert"></div>
    <div class="row g-4"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-body"><div id="items" class="list-group list-group-flush"></div></div></div></div><aside class="col-lg-4"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Budget Summary</h2><dl class="row mb-3"><dt class="col-7">Monthly Budget</dt><dd id="monthlyBudget" class="col-5 text-end">R0.00</dd><dt class="col-7">Selected Items Total</dt><dd id="selectedTotal" class="col-5 text-end">R0.00</dd><dt class="col-7">Remaining Budget</dt><dd id="remainingBudget" class="col-5 text-end">R0.00</dd><dt class="col-7">Percentage Used</dt><dd id="percentageUsed" class="col-5 text-end">0%</dd></dl><div class="progress mb-3"><div id="progress" class="progress-bar" style="width:0%"></div></div><button id="clearAll" class="btn btn-outline-danger w-100" type="button">Clear all</button></div></div></aside></div>
</section>
@section Scripts { <script>
(() => { const items = document.getElementById('items'), clear = document.getElementById('clearAll'), alertBox = document.getElementById('listAlert'); items.addEventListener('click', e => { const b=e.target.closest('[data-remove]'); if(b) request(`/ShoppingList/Remove/${b.dataset.remove}`); }); clear.addEventListener('click', () => request('/ShoppingList/Clear'));
async function request(url) { const r=await fetch(url,{method:'POST',headers:{Accept:'application/json'}}); const d=await r.json(); if(!r.ok) {alertBox.textContent=d.message||'Could not update the list.';alertBox.className='alert alert-danger';return;} render(d); }
async function load() { const r=await fetch('/ShoppingList/Data'); render(await r.json()); }
function render(data) { items.innerHTML=data.items.length ? data.items.map(i=>`<div class="list-group-item d-flex justify-content-between align-items-center gap-3"><div><strong>${html(i.productName)}</strong><div class="text-muted small">${money(i.price)}</div></div><button class="btn btn-sm btn-outline-danger" data-remove="${i.id}">Remove</button></div>`).join('') : '<p class="text-muted mb-0">No items selected yet.</p>'; set('monthlyBudget',money(data.monthlyBudget));set('selectedTotal',money(data.selectedTotal));set('remainingBudget',money(data.remainingBudget));set('percentageUsed',data.percentageUsed+'%'); const p=Math.min(100,Math.max(0,data.percentageUsed));document.getElementById('progress').style.width=p+'%';document.getElementById('progress').textContent=data.percentageUsed+'%'; clear.disabled=!data.items.length; }
function set(id,v){document.getElementById(id).textContent=v;} function money(v){return new Intl.NumberFormat('en-ZA',{style:'currency',currency:'ZAR'}).format(v);} function html(v){const e=document.createElement('span');e.textContent=v||'';return e.innerHTML;} load(); })();
</script> }
