@{ ViewData["Title"] = "Shopping List"; }
<section>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><h1 class="h2 fw-bold mb-1">Shopping List</h1><p class="text-muted mb-0">Mark an item as purchased to update your spending and personalized recommendations.</p></div><a href="/Catalog" class="btn btn-outline-primary">Browse Catalog</a></div>
    <div id="listAlert" class="alert d-none" role="alert"></div>
    <div class="row g-4"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-body"><div id="items" class="list-group list-group-flush"></div></div></div></div><aside class="col-lg-4"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Budget Summary</h2><dl class="row mb-3"><dt class="col-7">Monthly Budget</dt><dd id="monthlyBudget" class="col-5 text-end">R0.00</dd><dt class="col-7">Current Spending</dt><dd id="currentSpending" class="col-5 text-end">R0.00</dd><dt class="col-7">Selected Items Total</dt><dd id="selectedTotal" class="col-5 text-end">R0.00</dd><dt class="col-7">Remaining Budget</dt><dd id="remainingBudget" class="col-5 text-end">R0.00</dd><dt class="col-7">Percentage Used</dt><dd id="percentageUsed" class="col-5 text-end">0%</dd></dl><div class="progress mb-3"><div id="progress" class="progress-bar" style="width:0%"></div></div><button id="clearAll" class="btn btn-outline-danger w-100" type="button">Clear all</button></div></div></aside></div>
</section>
<dialog id="budgetLimitDialog" class="w-full max-w-md rounded-xl border-0 p-0 shadow-2xl backdrop:bg-slate-950/50" aria-labelledby="budgetLimitTitle">
    <div class="bg-white p-6 text-slate-800"><h2 id="budgetLimitTitle" class="mb-2 text-lg font-bold">Monthly budget reached</h2><p class="mb-5 text-sm text-slate-600">You have used your monthly budget. Your remaining balance is R0.00.</p><button id="closeBudgetLimitDialog" class="btn btn-primary w-100" type="button">Got it</button></div>
</dialog>
<dialog id="insufficientBalanceDialog" class="w-full max-w-md rounded-xl border-0 p-0 shadow-2xl backdrop:bg-slate-950/50" aria-labelledby="insufficientBalanceTitle">
    <div class="bg-white p-6 text-slate-800"><h2 id="insufficientBalanceTitle" class="mb-2 text-lg font-bold">Insufficient balance</h2><p id="insufficientBalanceMessage" class="mb-5 text-sm text-slate-600"></p><button id="closeInsufficientBalanceDialog" class="btn btn-primary w-100" type="button">Got it</button></div>
</dialog>
@section Scripts { <script>
(() => {
const items=document.getElementById('items'), clear=document.getElementById('clearAll'), alertBox=document.getElementById('listAlert');
const budgetLimitDialog=document.getElementById('budgetLimitDialog');
const insufficientBalanceDialog=document.getElementById('insufficientBalanceDialog');
document.getElementById('closeBudgetLimitDialog').addEventListener('click',()=>budgetLimitDialog.close());
document.getElementById('closeInsufficientBalanceDialog').addEventListener('click',()=>insufficientBalanceDialog.close());
items.addEventListener('click', event => { const visit=event.target.closest('[data-visit-store]'); if(visit) { window.visitStore(+visit.dataset.visitStore); return; } const purchase=event.target.closest('[data-purchase]'); if(purchase) { request(`/ShoppingList/Purchase/${purchase.dataset.purchase}`,true); return; } const remove=event.target.closest('[data-remove]'); if(remove) request(`/ShoppingList/Remove/${remove.dataset.remove}`); });
clear.addEventListener('click', () => request('/ShoppingList/Clear'));
async function request(url,isPurchase=false) { const response=await fetch(url,{method:'POST',headers:{Accept:'application/json'}}); const data=await response.json(); if(!response.ok) { const message=data.message||'Could not update the list.'; alertBox.textContent=message; alertBox.className='alert alert-danger'; if(data.insufficientBalance){document.getElementById('insufficientBalanceMessage').textContent=message;if(!insufficientBalanceDialog.open) insufficientBalanceDialog.showModal();} return; } if(isPurchase) { alertBox.textContent=data.message; alertBox.className='alert alert-success'; render(data.data); return; } render(data); }
async function load() { const response=await fetch('/ShoppingList/Data'); render(await response.json()); }
function render(data) { items.innerHTML=data.items.length ? data.items.map(item=>`<div class="list-group-item d-flex justify-content-between align-items-center gap-3"><div><strong>${html(item.productName)}</strong><div class="text-muted small">${money(item.price)}</div></div><div class="d-flex gap-2 flex-wrap justify-content-end"><button class="btn btn-sm btn-primary" data-visit-store="${item.productId}">Buy Now</button><button class="btn btn-sm btn-success" data-purchase="${item.id}">Mark purchased</button><button class="btn btn-sm btn-outline-danger" data-remove="${item.id}">Remove</button></div></div>`).join('') : '<p class="text-muted mb-0">No items selected yet.</p>'; set('monthlyBudget',money(data.monthlyBudget)); set('currentSpending',money(data.currentSpending)); set('selectedTotal',money(data.selectedTotal)); set('remainingBudget',money(data.remainingBudget)); set('percentageUsed',data.percentageUsed+'%'); const percentage=Math.min(100,Math.max(0,data.percentageUsed)); document.getElementById('progress').style.width=percentage+'%'; document.getElementById('progress').textContent=data.percentageUsed+'%'; clear.disabled=!data.items.length; if(data.budgetLimitReached&&!budgetLimitDialog.open) budgetLimitDialog.showModal(); }
function set(id,value){document.getElementById(id).textContent=value;} function money(value){return new Intl.NumberFormat('en-ZA',{style:'currency',currency:'ZAR'}).format(value);} function html(value){const element=document.createElement('span');element.textContent=value||'';return element.innerHTML;} load();
})();
</script> }
