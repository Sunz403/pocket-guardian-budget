@model IReadOnlyList<string>
@{ ViewData["Title"] = "Store Locator"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="h2 fw-bold mb-1">Store Locator</h1><p class="text-muted mb-0">Browse the configured stores and filter them by category.</p></div><a class="btn btn-outline-dark" href="/Shopping/Assistant">Shopping Assistant</a></div>
<div class="row g-4"><section class="col-lg-8"><div id="storeMap" class="border rounded-3 shadow-sm" style="height: 560px"></div></section><aside class="col-lg-4"><label for="category" class="form-label fw-semibold">Category</label><select id="category" class="form-select mb-3"><option value="">All stores</option>@foreach (var category in Model) { <option value="@category">@category</option> }</select><div id="storeList" class="list-group"></div></aside></div>
@section Scripts { <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>
(() => { const map=L.map('storeMap').setView([-29.84,31.01],11); L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; OpenStreetMap'}).addTo(map); let markers=[]; const category=document.getElementById('category'), list=document.getElementById('storeList'); async function load(){const r=await fetch('/Stores/Data?category='+encodeURIComponent(category.value));const stores=await r.json(); markers.forEach(m=>map.removeLayer(m));markers=stores.map(s=>L.marker([s.latitude,s.longitude]).addTo(map).bindPopup('<strong>'+escape(s.name)+'</strong><br>'+escape(s.address)+'<br><small>'+escape(s.category)+'</small>')); list.innerHTML=stores.map(s=>'<div class="list-group-item"><strong>'+escape(s.name)+'</strong><span class="d-block small text-muted">'+escape(s.category)+'</span><span class="d-block small">'+escape(s.address)+'</span></div>').join('')||'<div class="text-muted">No stores in this category.</div>'; if(markers.length) map.fitBounds(L.featureGroup(markers).getBounds().pad(.15));} function escape(v){const d=document.createElement('div');d.textContent=v||'';return d.innerHTML;} category.addEventListener('change',load);load(); })();
</script> }
